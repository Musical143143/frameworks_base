<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/charging_ring_mode_group"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:alpha="0"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/charging_ring_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/charging_ring_subtitle"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/charging_ring_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/charging_ring_badge_bg"
        android:paddingBottom="1dp"
        android:paddingEnd="4dp"
        android:paddingStart="4dp"
        android:paddingTop="1dp"
        android:text="@string/charging_ring_badge"
        android:textColor="#FFFFFFFF"
        android:textSize="8sp"/>

    <LinearLayout
        android:id="@+id/charging_ring_mode_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/charging_ring_pill_bg"
        android:orientation="horizontal"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/charging_ring_mode_low_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/charging_ring_mode_item_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="6dp"
            android:paddingEnd="12dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_bolt"
                android:tint="@color/charging_ring_mode_text_color"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charging_ring_mode_low_temp"
                android:textColor="@color/charging_ring_mode_text_color"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/charging_ring_mode_smart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/charging_ring_mode_item_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="6dp"
            android:paddingEnd="12dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_bolt"
                android:tint="@color/charging_ring_mode_text_color"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charging_ring_mode_smart"
                android:textColor="@color/charging_ring_mode_text_color"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/charging_ring_mode_hyper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/charging_ring_mode_item_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="6dp"
            android:paddingEnd="12dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_bolt"
                android:tint="@color/charging_ring_mode_text_color"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charging_ring_mode_hyper"
                android:textColor="@color/charging_ring_mode_text_color"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
