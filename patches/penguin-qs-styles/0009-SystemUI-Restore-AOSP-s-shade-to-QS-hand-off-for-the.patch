         animateQsTilesViewModel: AnimateQsTilesViewModel,
         toBouncerTransitionViewModel: ToBouncerTransitionViewModel,
         resources: Resources,
+        defaultQsStyle: Boolean,
     ): SceneTransitions {
         return transitions {
             interruptionHandler = DefaultInterruptionHandler
