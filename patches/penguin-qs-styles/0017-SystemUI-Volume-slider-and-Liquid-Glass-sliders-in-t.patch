+            glassAccent ?: MaterialTheme.colorScheme.onPrimary
         } else {
-            MaterialTheme.colorScheme.onSurface
+            if (glassAccent != null) Color.White else MaterialTheme.colorScheme.onSurface
         }
     )
     val painterRes = if (autoMode) {
