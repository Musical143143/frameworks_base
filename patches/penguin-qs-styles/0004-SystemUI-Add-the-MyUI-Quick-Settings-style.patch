+                    Box(Modifier.weight(1f)) {
+                        VolumeLayout(
+                            enable = interactable,
+                            verticalCornerRadius = MyUiSliderCorner,
+                            verticalWidth = null,
+                            sliderHeight = headerHeight,
+                        )
+                    }
+                    Box(Modifier.weight(1f)) {
+                        BrightnessLayout(
+                            enable = interactable,
+                            verticalCornerRadius = MyUiSliderCorner,
+                            verticalWidth = null,
+                            sliderHeight = headerHeight,
+                        )
+                    }
+                }
+            }
         }
     }
