+
+package com.android.systemui.qs.shared.style
+
+enum class QsPanelStyle(val value: Int) {
+    Default(0),
+
+    Penguin(1);
+
+    companion object {
+        const val SETTING_NAME = "qs_panel_style"
+
+        fun fromValue(value: Int): QsPanelStyle =
+            entries.firstOrNull { it.value == value } ?: Penguin
+    }
+}
